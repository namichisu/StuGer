# Required — MySQL connection (use a cloud MySQL provider on Vercel)
DB_HOST=your-cloud-mysql-host
DB_PORT=3306
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=student_management_db

# Optional — set to 'true' if your cloud DB requires SSL (PlanetScale, Aiven, etc.)
DB_SSL=false

# Optional — restrict CORS to your Vercel domain in production
CORS_ORIGIN=*

# Set automatically by Vercel in production — do not set manually
# NODE_ENV=production
