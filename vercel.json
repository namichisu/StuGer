{
  "version": 2,
  "builds": [
    {
      "src": "backend/server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "backend/server.js" },
    { "src": "/admin",   "dest": "/frontend/admin.html" },
    { "src": "/student", "dest": "/frontend/student.html" },
    { "src": "/login",   "dest": "/frontend/index.html" },
    { "src": "/css/(.*)", "dest": "/frontend/css/$1" },
    { "src": "/js/(.*)",  "dest": "/frontend/js/$1" },
    { "src": "/",         "dest": "/frontend/index.html" }
  ]
}
